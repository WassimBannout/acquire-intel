# AcquireIntel — environment template.
#
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; never commit secrets.
# Every key the app reads is listed here (parsed by src/acquire_intel/config).
# Required keys are left blank — the app fails fast at startup until they are set.
# Keys with a value shown are non-secret defaults you may override.

# --- database (required) -----------------------------------------------------
# SQLAlchemy URL. Example: postgresql+psycopg://acquire:acquire@localhost:5432/acquire
DATABASE_URL=

# --- api ---------------------------------------------------------------------
FLASK_SECRET_KEY=                 # required — Flask session signing secret
ADMIN_TOKEN=                      # required — bearer token gating on-demand/admin crawl
API_BASE_PATH=/api/v1

# --- acquisition (respectful crawling; docs/08) ------------------------------
CONTACT_USER_AGENT=AcquireIntelBot/0.1 (+contact@example.com)
ROBOTSTXT_OBEY=true
PROXY_POOL=                       # comma-separated proxy URLs; empty = crawl directly
PROXY_COOLDOWN_SECONDS=60.0       # how long a banned proxy is quarantined before reuse
ROTATION_MAX_ATTEMPTS=4           # identity rotations / cookie retries per request before giving up
DEFAULT_DOWNLOAD_DELAY=1.0
AUTOTHROTTLE_ENABLED=true

# --- data-quality gates (docs/04 §3) -----------------------------------------
QUALITY_PRICE_MIN=0               # lowest plausible price; below → quarantined (out_of_range)
QUALITY_PRICE_MAX=1000000         # highest plausible price; catches digit-concat scrape errors
QUALITY_MAX_JUMP_RATIO=10.0       # max price change factor vs. a product's last (discontinuous)
QUALITY_VOLUME_TOLERANCE=0.5      # run item count must be within ±this fraction of the baseline
QUALITY_VOLUME_MIN_BASELINE=5     # skip the volume gate until the baseline is at least this large

# --- analytics: deal detection (docs/07) -------------------------------------
DEAL_MIN_DROP_PCT=10.0            # min drop from a product's recent high (%) to count as a deal
DEAL_WINDOW_DAYS=90              # lookback window (days) for a product's recent high

# --- harness (tests) ---------------------------------------------------------
HARNESS_BASE_URL=http://localhost:8999
