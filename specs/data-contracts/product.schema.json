{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acquire-intel.dev/contracts/product.schema.json",
  "title": "Product",
  "description": "Canonical product projection (upsert). Rebuildable from observations + latest crawl.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Canonical id: {source_id}:{external_id}" },
    "source_id": { "type": "string" },
    "external_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "brand": { "type": ["string", "null"] },
    "url": { "type": "string" },
    "image_url": { "type": ["string", "null"] },
    "latest_price": {
      "oneOf": [
        { "$ref": "#/$defs/Money" },
        { "type": "null" }
      ]
    },
    "in_stock": { "type": ["boolean", "null"] },
    "first_seen_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "source_id", "external_id", "title", "url", "first_seen_at", "last_seen_at"],
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "string", "description": "Decimal serialized as string" },
        "currency": { "type": "string", "description": "ISO-4217" }
      },
      "required": ["amount", "currency"]
    }
  }
}
